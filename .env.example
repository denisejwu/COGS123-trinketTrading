# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your keys never get committed.
# The app only needs these public values. Never put the Supabase secret
# (service role) key in this app.

# Supabase dashboard -> Project Settings -> API Keys (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (starts with sb_publishable_). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The address of the site, used for links in emails.
# Local: http://localhost:3000   Production: your Vercel URL
NEXT_PUBLIC_SITE_URL=
